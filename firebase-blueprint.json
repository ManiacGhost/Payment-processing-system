{
  "entities": {
    "Payment": {
      "title": "Payment",
      "description": "Represents a payment transaction in the system.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID of the user who initiated the payment." },
        "amount": { "type": "number", "description": "The transaction amount." },
        "currency": { "type": "string", "description": "The currency code (e.g., USD)." },
        "status": { 
          "type": "string", 
          "enum": ["PENDING", "PROCESSING", "SUCCESS", "FAILED"], 
          "description": "Current state of the payment lifecycle." 
        },
        "idempotencyKey": { "type": "string", "description": "Unique key to prevent duplicate processing." },
        "retryCount": { "type": "integer", "description": "Number of retry attempts made." },
        "lastError": { "type": "string", "description": "Description of the last failure." },
        "gatewayReference": { "type": "string", "description": "External reference from the payment gateway." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object", "description": "Additional unstructured data." }
      },
      "required": ["userId", "amount", "currency", "status", "idempotencyKey", "createdAt", "updatedAt"]
    },
    "WebhookLog": {
      "title": "Webhook Log",
      "description": "Logs of asynchronous callbacks from the payment gateway.",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string" },
        "payload": { "type": "object" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["PROCESSED", "IGNORED", "CONFLICT"] }
      },
      "required": ["paymentId", "payload", "receivedAt", "status"]
    }
  },
  "firestore": {
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Collection of payment records."
    },
    "/webhook_logs/{logId}": {
      "schema": "WebhookLog",
      "description": "History of received webhooks."
    }
  }
}
